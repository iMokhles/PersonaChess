{
  "name": "personachess",
  "productName": "PersonaChess",
  "version": "2.0.0",
  "description": "Human-like chess move generator using Stockfish analysis",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "test": "node tests/run-tests.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "postinstall": "cp node_modules/stockfish.js/stockfish.js public/ && cp node_modules/stockfish.js/stockfish.wasm public/"
  },
  "keywords": [
    "chess",
    "stockfish",
    "electron",
    "mvvm"
  ],
  "author": {
    "name": "iMokhles",
    "email": "mokhlashussein@aol.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "40.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~4.5.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "chess.js": "^1.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.4",
    "react-chessboard": "^5.8.6",
    "react-dom": "^19.2.4",
    "stockfish.js": "^10.0.2"
  }
}
